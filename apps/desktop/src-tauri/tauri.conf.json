{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feilian Lite",
  "version": "0.1.0",
  "identifier": "dev.feilian.lite",
  "build": {
    "beforeDevCommand": "npm run build:helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:helper:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Feilian Lite",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Feilian Lite Contributors",
    "category": "Utility",
    "shortDescription": "Lightweight desktop client for Feilian VPN",
    "longDescription": "Feilian Lite provides Feishu and OIDC authentication with system split-tunnel and local SOCKS5 VPN modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/feilian-helper"
    ]
  }
}